    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Tips",
                    "textStyle": {
                      "fontSize": "20pt",
                      "fontWeight": "bold",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Drop a dimension in the Legend bucket to stack every bar into segments, with on-bar segment labels and tinted backgrounds (Legend card).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Canada and USA are explicitly demoted here (Pillars → Is pillar = false); the first/last pillar default is per data point, you decide.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Segments aggregate at bar level: they stay consistent even when a Table dimension splits the data further.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  The synthetic Grand total pillar closes the walk; its card owns the toggle, the caption (« Actual net sales ») and its styling.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Bar width is fixed at 80 px (Layout card); per-item colours live in the Legend card.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Click a segment to cross-highlight the rest of the page: selection works like any native visual.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              }
            ]
          }
