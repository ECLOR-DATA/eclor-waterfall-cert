          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "2 · Pick a mode  (General → Waterfall mode)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "20pt",
                      "color": "#8958fe"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Cumulative: categories chain into one running statement (Sale Price → … → Profit). First and last categories are pillars by default; promote or demote ANY data point with Pillars → Is pillar (this file pins Gross Sales, Sales and Profit).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Comparison: each Value measure becomes a pillar and the bridges explain the gap, category by category (page 3: M vs M-1 by country).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Comparison needs a Category field: without one the visual falls back to Cumulative.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Sign convention: income positive, costs negative. COGS and Discounts are negated in the source query; the waterfall does the rest.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
