                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Cumulative: a full statement walk with pinned pillars, fx pillar colours, variation arcs, and the Table bucket as an analysis table.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Comparaison: two measures compared pillar-to-pillar, with variance rails, floor offset + broken axis and conditional bridge colours.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Legend: bars stacked into segments, per-point pillar overrides, the synthetic Grand total pillar.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Each page carries a Tips panel: the format-pane path for every feature you see.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Support: ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  },
                  {
                    "value": "github.com/ECLOR-DATA/eclor-waterfall/issues",
