{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "cum-tips",
  "position": {
    "x": 1470,
    "y": 175,
    "width": 415,
    "height": 870,
    "z": 600,
    "tabOrder": 9000
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Tips",
                    "textStyle": {
                      "fontSize": "20pt",
                      "fontWeight": "bold",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Waterfall mode = Cumulative (General card): the categories chain into one running statement, Sale Price → … → Profit.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  The bars follow the statement order because the Category column is sorted by a hidden order key (Sort by column); the visual respects the model sort.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Gross Sales, Sales and Profit are pinned as pillars per data point (Pillars → Is pillar); everything else bridges between them. First and last categories are pillars by default.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Pillar colours come from one measure: Pillars → Pillar colour → fx → Field value → [_Color_Category].",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Variation arcs (Variation arc card) label the % path between pillars; their background is a conditional fx rule (red < 0, green > 0). Per data point you can hide an arc (Profit) or keep a single arrowhead (Sales).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  The Table bucket (here: Country) adds Excel-like analysis rows under the chart, aligned with the bars: cells always sum to the bar.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Extra buckets: Tooltips takes any hover measure; Grand total label overrides the total caption dynamically.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
