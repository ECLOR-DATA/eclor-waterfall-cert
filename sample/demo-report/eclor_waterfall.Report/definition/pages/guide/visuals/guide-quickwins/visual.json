              {
                "textRuns": [
                  {
                    "value": "3 · Five quick wins",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "20pt",
                      "color": "#1ef5b1"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Sort bars in statement order with a hidden sort key (Category is sorted by Order_Category: model-level Sort by column).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Drive colours with measures: Pillar colour → fx → Field value → [_Color_Category]. One SWITCH measure = the whole palette.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Conditional rules work everywhere: bridges and arc labels here turn red/green from the sign of [Δ M-1].",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Y axis → Floor offset (75 % on page 3) amplifies pillar-to-pillar deltas; the striped broken-axis marker keeps the chart honest.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Format strings are respected verbatim: the “€” comes from the measure format string, never double-scaled.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#091612"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
